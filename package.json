{
  "name": "term-pusher-pad",
  "version": "1.0.0",
  "description": "Terminal content pusher with Electron + xterm.js + node-pty",
  "main": "src/main/main.js",
  "scripts": {
    "rebuild": "electron-rebuild -f -w node-pty",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "concurrently -k -n \"vite,electron\" -c \"cyan,green\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build": "vite build"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.3.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "mermaid": "^11.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  }
}
